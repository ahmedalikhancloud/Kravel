# Optional CPU retrieval models. Default kravel:local remains lightweight.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_XET=1 TOKENIZERS_PARALLELISM=false \
    MLFLOW_DISABLE_TELEMETRY=true OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
WORKDIR /app
# Install CPU wheels first, rather than pulling multi-GB CUDA dependencies.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch==2.14.1+cpu'
RUN pip install --no-cache-dir 'sentence-transformers==5.7.0' 'mlflow==3.16.0'
COPY kravel/rag_artifacts.py /tmp/kravel-rag-artifacts.py
RUN python /tmp/kravel-rag-artifacts.py \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin kravel \
    && mkdir -p /data && chown kravel:kravel /data
COPY kravel ./kravel
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    KRAVEL_RAG_EMBEDDING_PATH=/models/embedding KRAVEL_RAG_RERANKER_PATH=/models/reranker \
    KRAVEL_SYNTHETIC_RUNBOOKS=1
USER kravel
EXPOSE 8084
CMD ["python", "-m", "kravel.rag_service"]
